Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Size (m): 0.05
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
    - Class: rviz_default_plugins/Path
      Name: Planned path
      Enabled: true
      Topic:
        Value: /explore/path
    - Class: rviz_default_plugins/Marker
      Name: Goal
      Enabled: true
      Topic:
        Value: /explore/goal
    - Class: rviz_default_plugins/Image
      Name: Camera + YOLO
      Enabled: true
      Topic:
        Value: /camera/detections_image
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Name: root
Window Geometry:
  Height: 900
  Width: 1500
