<?xml version="1.0" ?>
<!--
  NIDAR simplified indoor SAR world  (Gazebo Sim 8 / Harmonic, SDF 1.9)
  Origin (0,0) = centre of the 15 m x 15 m building. +x = east, +y = north (ENU).
  Entrance: south wall, x = 0, 1.5 m wide.  Drone start: pad outside the entrance at (0,-8).
  World name kept as "airmouse_maze" so existing bridges / scripts that reference
  /world/airmouse_maze/... keep working.
-->
<sdf version="1.9">
  <world name="airmouse_maze">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- needed by the drone's LiDAR / camera / IMU sensors -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.3 0.3 0.35 1</background>
      <shadows>false</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.3 0.2 -1</direction>
    </light>

    <!-- 15 x 15 m floor (top surface at z = 0) -->
    <model name="arena_floor">
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>
      <link name="floor">
        <collision name="c"><geometry><box><size>15 15 0.1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>15 15 0.1</size></box></geometry>
          <material><ambient>0.35 0.37 0.40 1</ambient><diffuse>0.35 0.37 0.40 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 5 x 2.5 m floor strip outside the entrance (start pad area) -->
    <model name="outside_apron">
      <static>true</static>
      <pose>0 -8.75 -0.05 0 0 0</pose>
      <link name="apron">
        <collision name="c"><geometry><box><size>5 2.5 0.1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>5 2.5 0.1</size></box></geometry>
          <material><ambient>0.35 0.37 0.40 1</ambient><diffuse>0.35 0.37 0.40 1</diffuse></material></visual>
      </link>
    </model>

    <!-- all walls: 0.15 m thick, 3.0 m high, full collision -->
    <model name="walls">
      <static>true</static>
      <link name="walls">
        <collision name="outer_W_c"><pose>-7.425 0.0 1.5 0 0 0</pose><geometry><box><size>0.15 15.0 3.0</size></box></geometry></collision>
        <visual name="outer_W_v"><pose>-7.425 0.0 1.5 0 0 0</pose><geometry><box><size>0.15 15.0 3.0</size></box></geometry><material><ambient>0.88 0.85 0.78 1</ambient><diffuse>0.88 0.85 0.78 1</diffuse></material></visual>
        <collision name="outer_E_c"><pose>7.425 0.0 1.5 0 0 0</pose><geometry><box><size>0.15 15.0 3.0</size></box></geometry></collision>
        <visual name="outer_E_v"><pose>7.425 0.0 1.5 0 0 0</pose><geometry><box><size>0.15 15.0 3.0</size></box></geometry><material><ambient>0.88 0.85 0.78 1</ambient><diffuse>0.88 0.85 0.78 1</diffuse></material></visual>
        <collision name="outer_N_0_c"><pose>0.0 7.425 1.5 0 0 0</pose><geometry><box><size>14.7 0.15 3.0</size></box></geometry></collision>
        <visual name="outer_N_0_v"><pose>0.0 7.425 1.5 0 0 0</pose><geometry><box><size>14.7 0.15 3.0</size></box></geometry><material><ambient>0.88 0.85 0.78 1</ambient><diffuse>0.88 0.85 0.78 1</diffuse></material></visual>
        <collision name="outer_S_0_c"><pose>-4.05 -7.425 1.5 0 0 0</pose><geometry><box><size>6.6 0.15 3.0</size></box></geometry></collision>
        <visual name="outer_S_0_v"><pose>-4.05 -7.425 1.5 0 0 0</pose><geometry><box><size>6.6 0.15 3.0</size></box></geometry><material><ambient>0.88 0.85 0.78 1</ambient><diffuse>0.88 0.85 0.78 1</diffuse></material></visual>
        <collision name="outer_S_1_c"><pose>4.05 -7.425 1.5 0 0 0</pose><geometry><box><size>6.6 0.15 3.0</size></box></geometry></collision>
        <visual name="outer_S_1_v"><pose>4.05 -7.425 1.5 0 0 0</pose><geometry><box><size>6.6 0.15 3.0</size></box></geometry><material><ambient>0.88 0.85 0.78 1</ambient><diffuse>0.88 0.85 0.78 1</diffuse></material></visual>
        <collision name="leg_W_c"><pose>-1.075 -2.925 1.5 0 0 0</pose><geometry><box><size>0.15 8.85 3.0</size></box></geometry></collision>
        <visual name="leg_W_v"><pose>-1.075 -2.925 1.5 0 0 0</pose><geometry><box><size>0.15 8.85 3.0</size></box></geometry><material><ambient>0.88 0.85 0.78 1</ambient><diffuse>0.88 0.85 0.78 1</diffuse></material></visual>
        <collision name="leg_E_c"><pose>1.075 -2.925 1.5 0 0 0</pose><geometry><box><size>0.15 8.85 3.0</size></box></geometry></collision>
        <visual name="leg_E_v"><pose>1.075 -2.925 1.5 0 0 0</pose><geometry><box><size>0.15 8.85 3.0</size></box></geometry><material><ambient>0.88 0.85 0.78 1</ambient><diffuse>0.88 0.85 0.78 1</diffuse></material></visual>
        <collision name="corr_S_W_0_c"><pose>-4.25 1.425 1.5 0 0 0</pose><geometry><box><size>6.2 0.15 3.0</size></box></geometry></collision>
        <visual name="corr_S_W_0_v"><pose>-4.25 1.425 1.5 0 0 0</pose><geometry><box><size>6.2 0.15 3.0</size></box></geometry><material><ambient>0.88 0.85 0.78 1</ambient><diffuse>0.88 0.85 0.78 1</diffuse></material></visual>
        <collision name="corr_S_E_0_c"><pose>4.25 1.425 1.5 0 0 0</pose><geometry><box><size>6.2 0.15 3.0</size></box></geometry></collision>
        <visual name="corr_S_E_0_v"><pose>4.25 1.425 1.5 0 0 0</pose><geometry><box><size>6.2 0.15 3.0</size></box></geometry><material><ambient>0.88 0.85 0.78 1</ambient><diffuse>0.88 0.85 0.78 1</diffuse></material></visual>
        <collision name="corr_N_0_c"><pose>-6.525 3.575 1.5 0 0 0</pose><geometry><box><size>1.65 0.15 3.0</size></box></geometry></collision>
        <visual name="corr_N_0_v"><pose>-6.525 3.575 1.5 0 0 0</pose><geometry><box><size>1.65 0.15 3.0</size></box></geometry><material><ambient>0.88 0.85 0.78 1</ambient><diffuse>0.88 0.85 0.78 1</diffuse></material></visual>
        <collision name="corr_N_1_c"><pose>-3.575 3.575 1.5 0 0 0</pose><geometry><box><size>1.45 0.15 3.0</size></box></geometry></collision>
        <visual name="corr_N_1_v"><pose>-3.575 3.575 1.5 0 0 0</pose><geometry><box><size>1.45 0.15 3.0</size></box></geometry><material><ambient>0.88 0.85 0.78 1</ambient><diffuse>0.88 0.85 0.78 1</diffuse></material></visual>
        <collision name="corr_N_2_c"><pose>0.15 3.575 1.5 0 0 0</pose><geometry><box><size>3.4 0.15 3.0</size></box></geometry></collision>
        <visual name="corr_N_2_v"><pose>0.15 3.575 1.5 0 0 0</pose><geometry><box><size>3.4 0.15 3.0</size></box></geometry><material><ambient>0.88 0.85 0.78 1</ambient><diffuse>0.88 0.85 0.78 1</diffuse></material></visual>
        <collision name="corr_N_3_c"><pose>3.775 3.575 1.5 0 0 0</pose><geometry><box><size>0.85 0.15 3.0</size></box></geometry></collision>
        <visual name="corr_N_3_v"><pose>3.775 3.575 1.5 0 0 0</pose><geometry><box><size>0.85 0.15 3.0</size></box></geometry><material><ambient>0.88 0.85 0.78 1</ambient><diffuse>0.88 0.85 0.78 1</diffuse></material></visual>
        <collision name="corr_N_4_c"><pose>6.375 3.575 1.5 0 0 0</pose><geometry><box><size>1.95 0.15 3.0</size></box></geometry></collision>
        <visual name="corr_N_4_v"><pose>6.375 3.575 1.5 0 0 0</pose><geometry><box><size>1.95 0.15 3.0</size></box></geometry><material><ambient>0.88 0.85 0.78 1</ambient><diffuse>0.88 0.85 0.78 1</diffuse></material></visual>
        <collision name="part_1_c"><pose>-3.75 5.5 1.5 0 0 0</pose><geometry><box><size>0.15 3.7 3.0</size></box></geometry></collision>
        <visual name="part_1_v"><pose>-3.75 5.5 1.5 0 0 0</pose><geometry><box><size>0.15 3.7 3.0</size></box></geometry><material><ambient>0.88 0.85 0.78 1</ambient><diffuse>0.88 0.85 0.78 1</diffuse></material></visual>
        <collision name="part_2_c"><pose>0.0 5.5 1.5 0 0 0</pose><geometry><box><size>0.15 3.7 3.0</size></box></geometry></collision>
        <visual name="part_2_v"><pose>0.0 5.5 1.5 0 0 0</pose><geometry><box><size>0.15 3.7 3.0</size></box></geometry><material><ambient>0.88 0.85 0.78 1</ambient><diffuse>0.88 0.85 0.78 1</diffuse></material></visual>
        <collision name="part_3_c"><pose>3.75 5.5 1.5 0 0 0</pose><geometry><box><size>0.15 3.7 3.0</size></box></geometry></collision>
        <visual name="part_3_v"><pose>3.75 5.5 1.5 0 0 0</pose><geometry><box><size>0.15 3.7 3.0</size></box></geometry><material><ambient>0.88 0.85 0.78 1</ambient><diffuse>0.88 0.85 0.78 1</diffuse></material></visual>
      </link>
    </model>

    <!-- obstacles: 1.5 m high so the 2D LiDAR sees them at normal indoor flight height -->
    <model name="obstacles">
      <static>true</static>
      <link name="obstacles">
        <collision name="O1_leg_pillar_c"><pose>0.8 -3.6 0.75 0 0 0</pose><geometry><box><size>0.4 0.4 1.5</size></box></geometry></collision>
        <visual name="O1_leg_pillar_v"><pose>0.8 -3.6 0.75 0 0 0</pose><geometry><box><size>0.4 0.4 1.5</size></box></geometry><material><ambient>0.80 0.40 0.10 1</ambient><diffuse>0.80 0.40 0.10 1</diffuse></material></visual>
        <collision name="O2_corridor_cabinet_c"><pose>-3.0 1.75 0.75 0 0 0</pose><geometry><box><size>0.5 0.5 1.5</size></box></geometry></collision>
        <visual name="O2_corridor_cabinet_v"><pose>-3.0 1.75 0.75 0 0 0</pose><geometry><box><size>0.5 0.5 1.5</size></box></geometry><material><ambient>0.80 0.40 0.10 1</ambient><diffuse>0.80 0.40 0.10 1</diffuse></material></visual>
        <collision name="O3_N2_occluder_c"><pose>-1.6 6.0 0.75 0 0 0</pose><geometry><box><size>0.6 0.6 1.5</size></box></geometry></collision>
        <visual name="O3_N2_occluder_v"><pose>-1.6 6.0 0.75 0 0 0</pose><geometry><box><size>0.6 0.6 1.5</size></box></geometry><material><ambient>0.80 0.40 0.10 1</ambient><diffuse>0.80 0.40 0.10 1</diffuse></material></visual>
        <collision name="O4_N4_occluder_c"><pose>6.1 5.3 0.75 0 0 0</pose><geometry><box><size>0.8 0.8 1.5</size></box></geometry></collision>
        <visual name="O4_N4_occluder_v"><pose>6.1 5.3 0.75 0 0 0</pose><geometry><box><size>0.8 0.8 1.5</size></box></geometry><material><ambient>0.80 0.40 0.10 1</ambient><diffuse>0.80 0.40 0.10 1</diffuse></material></visual>
        <collision name="O5_N3_crate_c"><pose>0.9 5.0 0.75 0 0 0</pose><geometry><box><size>0.6 0.6 1.5</size></box></geometry></collision>
        <visual name="O5_N3_crate_v"><pose>0.9 5.0 0.75 0 0 0</pose><geometry><box><size>0.6 0.6 1.5</size></box></geometry><material><ambient>0.80 0.40 0.10 1</ambient><diffuse>0.80 0.40 0.10 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ENTRY sign: lintel above the 1.5 m opening (clear height 2.0 m), letters on both faces -->
    <model name="entry_sign">
      <static>true</static>
      <link name="sign_link">
        <collision name="board_c"><pose>0 -7.425 2.5 0 0 0</pose><geometry><box><size>1.5 0.15 1.0</size></box></geometry></collision>
        <visual name="board_v"><pose>0 -7.425 2.5 0 0 0</pose><geometry><box><size>1.5 0.15 1.0</size></box></geometry><material><ambient>0.05 0.35 0.10 1</ambient><diffuse>0.05 0.45 0.12 1</diffuse></material></visual>
        <visual name="out_L0_E_0_0"><pose>-0.6300 -7.51 2.6350 0 0 0</pose><geometry><box><size>0.045 0.02 0.045</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><emissive>1 1 1 1</emissive></material></visual>
        <visual name="out_L0_E_0_1"><pose>-0.5850 -7.51 2.6350 0 0 0</pose><geometry><box><size>0.045 0.02 0.045</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><emissive>1 1 1 1</emissive></material></visual>
        <visual name="out_L0_E_0_2"><pose>-0.5400 -7.51 2.6350 0 0 0</pose><geometry><box><size>0.045 0.02 0.045</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><emissive>1 1 1 1</emissive></material></visual>
        <visual name="out_L0_E_0_3"><pose>-0.4950 -7.51 2.6350 0 0 0</pose><geometry><box><size>0.045 0.02 0.045</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><emissive>1 1 1 1</emissive></material></visual>
        <visual name="out_L0_E_0_4"><pose>-0.4500 -7.51 2.6350 0 0 0</pose><geometry><box><size>0.045 0.02 0.045</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><emissive>1 1 1 1</emissive></material></visual>
        <visual name="out_L0_E_1_0"><pose>-0.6300 -7.51 2.5900 0 0 0</pose><geometry><box><size>0.045 0.02 0.045</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><emissive>1 1 1 1</emissive></material></visual>
        <visual name="out_L0_E_2_0"><pose>-0.6300 -7.51 2.5450 0 0 0</pose><geometry><box><size>0.045 0.02 0.045</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><emissive>1 1 1 1</emissive></material></visual>
        <visual name="out_L0_E_3_0"><pose>-0.6300 -7.51 2.5000 0 0 0</pose><geometry><box><size>0.045 0.02 0.045</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><emissive>1 1 1 1</emissive></material></visual>
