        <visual name="out_L1_N_3_0"><pose>-0.3600 -7.51 2.5000 0 0 0</pose><geometry><box><size>0.045 0.02 0.045</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><emissive>1 1 1 1</emissive></material></visual>
