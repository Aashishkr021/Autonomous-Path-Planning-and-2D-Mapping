<?xml version="1.0" ?>
<!--
  NIDAR 5-room SAR world (4 corner rooms + 1 centre room)  (Gazebo Sim 8 / Harmonic, SDF 1.9)
  Origin (0,0) = centre of the 15 m x 15 m building. +x = east, +y = north (ENU).
  Entrance: south wall, x = 0, 1.5 m wide.  Drone start: pad outside the entrance at (0,-8).
  World name kept as "airmouse_maze" so existing bridges / scripts that reference
  /world/airmouse_maze/... keep working.
-->
<sdf version="1.9">
  <world name="airmouse_maze">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- needed by the drone's LiDAR / camera / IMU sensors -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.3 0.3 0.35 1</background>
      <shadows>false</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.3 0.2 -1</direction>
    </light>

    <!-- 15 x 15 m floor (top surface at z = 0) -->
    <model name="arena_floor">
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>
      <link name="floor">
        <collision name="c"><geometry><box><size>15 15 0.1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>15 15 0.1</size></box></geometry>
          <material><ambient>0.35 0.37 0.40 1</ambient><diffuse>0.35 0.37 0.40 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 5 x 2.5 m floor strip outside the entrance (start pad area) -->
    <model name="outside_apron">
      <static>true</static>
      <pose>0 -8.75 -0.05 0 0 0</pose>
      <link name="apron">
        <collision name="c"><geometry><box><size>5 2.5 0.1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>5 2.5 0.1</size></box></geometry>
          <material><ambient>0.35 0.37 0.40 1</ambient><diffuse>0.35 0.37 0.40 1</diffuse></material></visual>
      </link>
    </model>

    <!-- all walls: 0.15 m thick, 3.0 m high, full collision -->
    <model name="walls">
      <static>true</static>
      <link name="walls">
        <collision name="outer_W_c"><pose>-7.425 0.0 1.5 0 0 0</pose><geometry><box><size>0.15 15.0 3.0</size></box></geometry></collision>
        <visual name="outer_W_v"><pose>-7.425 0.0 1.5 0 0 0</pose><geometry><box><size>0.15 15.0 3.0</size></box></geometry><material><ambient>0.88 0.85 0.78 1</ambient><diffuse>0.88 0.85 0.78 1</diffuse></material></visual>
        <collision name="outer_E_c"><pose>7.425 0.0 1.5 0 0 0</pose><geometry><box><size>0.15 15.0 3.0</size></box></geometry></collision>
        <visual name="outer_E_v"><pose>7.425 0.0 1.5 0 0 0</pose><geometry><box><size>0.15 15.0 3.0</size></box></geometry><material><ambient>0.88 0.85 0.78 1</ambient><diffuse>0.88 0.85 0.78 1</diffuse></material></visual>
        <collision name="outer_N_0_c"><pose>0.0 7.425 1.5 0 0 0</pose><geometry><box><size>14.7 0.15 3.0</size></box></geometry></collision>
        <visual name="outer_N_0_v"><pose>0.0 7.425 1.5 0 0 0</pose><geometry><box><size>14.7 0.15 3.0</size></box></geometry><material><ambient>0.88 0.85 0.78 1</ambient><diffuse>0.88 0.85 0.78 1</diffuse></material></visual>
        <collision name="outer_S_0_c"><pose>-4.05 -7.425 1.5 0 0 0</pose><geometry><box><size>6.6 0.15 3.0</size></box></geometry></collision>
        <visual name="outer_S_0_v"><pose>-4.05 -7.425 1.5 0 0 0</pose><geometry><box><size>6.6 0.15 3.0</size></box></geometry><material><ambient>0.88 0.85 0.78 1</ambient><diffuse>0.88 0.85 0.78 1</diffuse></material></visual>
        <collision name="outer_S_1_c"><pose>4.05 -7.425 1.5 0 0 0</pose><geometry><box><size>6.6 0.15 3.0</size></box></geometry></collision>
        <visual name="outer_S_1_v"><pose>4.05 -7.425 1.5 0 0 0</pose><geometry><box><size>6.6 0.15 3.0</size></box></geometry><material><ambient>0.88 0.85 0.78 1</ambient><diffuse>0.88 0.85 0.78 1</diffuse></material></visual>
        <collision name="SW_N_0_c"><pose>-5.775 -4.275 1.5 0 0 0</pose><geometry><box><size>3.15 0.15 3.0</size></box></geometry></collision>
        <visual name="SW_N_0_v"><pose>-5.775 -4.275 1.5 0 0 0</pose><geometry><box><size>3.15 0.15 3.0</size></box></geometry><material><ambient>0.88 0.85 0.78 1</ambient><diffuse>0.88 0.85 0.78 1</diffuse></material></visual>
        <collision name="SW_E_0_c"><pose>-4.275 -6.8 1.5 0 0 0</pose><geometry><box><size>0.15 1.1 3.0</size></box></geometry></collision>
        <visual name="SW_E_0_v"><pose>-4.275 -6.8 1.5 0 0 0</pose><geometry><box><size>0.15 1.1 3.0</size></box></geometry><material><ambient>0.88 0.85 0.78 1</ambient><diffuse>0.88 0.85 0.78 1</diffuse></material></visual>
        <collision name="SW_E_1_c"><pose>-4.275 -4.65 1.5 0 0 0</pose><geometry><box><size>0.15 0.6 3.0</size></box></geometry></collision>
        <visual name="SW_E_1_v"><pose>-4.275 -4.65 1.5 0 0 0</pose><geometry><box><size>0.15 0.6 3.0</size></box></geometry><material><ambient>0.88 0.85 0.78 1</ambient><diffuse>0.88 0.85 0.78 1</diffuse></material></visual>
        <collision name="SE_N_0_c"><pose>4.5 -4.275 1.5 0 0 0</pose><geometry><box><size>0.6 0.15 3.0</size></box></geometry></collision>
        <visual name="SE_N_0_v"><pose>4.5 -4.275 1.5 0 0 0</pose><geometry><box><size>0.6 0.15 3.0</size></box></geometry><material><ambient>0.88 0.85 0.78 1</ambient><diffuse>0.88 0.85 0.78 1</diffuse></material></visual>
        <collision name="SE_N_1_c"><pose>6.775 -4.275 1.5 0 0 0</pose><geometry><box><size>1.15 0.15 3.0</size></box></geometry></collision>
        <visual name="SE_N_1_v"><pose>6.775 -4.275 1.5 0 0 0</pose><geometry><box><size>1.15 0.15 3.0</size></box></geometry><material><ambient>0.88 0.85 0.78 1</ambient><diffuse>0.88 0.85 0.78 1</diffuse></material></visual>
        <collision name="SE_W_0_c"><pose>4.275 -5.85 1.5 0 0 0</pose><geometry><box><size>0.15 3.0 3.0</size></box></geometry></collision>
        <visual name="SE_W_0_v"><pose>4.275 -5.85 1.5 0 0 0</pose><geometry><box><size>0.15 3.0 3.0</size></box></geometry><material><ambient>0.88 0.85 0.78 1</ambient><diffuse>0.88 0.85 0.78 1</diffuse></material></visual>
        <collision name="NW_S_0_c"><pose>-6.8 4.275 1.5 0 0 0</pose><geometry><box><size>1.1 0.15 3.0</size></box></geometry></collision>
        <visual name="NW_S_0_v"><pose>-6.8 4.275 1.5 0 0 0</pose><geometry><box><size>1.1 0.15 3.0</size></box></geometry><material><ambient>0.88 0.85 0.78 1</ambient><diffuse>0.88 0.85 0.78 1</diffuse></material></visual>
        <collision name="NW_S_1_c"><pose>-4.475 4.275 1.5 0 0 0</pose><geometry><box><size>0.55 0.15 3.0</size></box></geometry></collision>
        <visual name="NW_S_1_v"><pose>-4.475 4.275 1.5 0 0 0</pose><geometry><box><size>0.55 0.15 3.0</size></box></geometry><material><ambient>0.88 0.85 0.78 1</ambient><diffuse>0.88 0.85 0.78 1</diffuse></material></visual>
        <collision name="NW_E_0_c"><pose>-4.275 5.85 1.5 0 0 0</pose><geometry><box><size>0.15 3.0 3.0</size></box></geometry></collision>
        <visual name="NW_E_0_v"><pose>-4.275 5.85 1.5 0 0 0</pose><geometry><box><size>0.15 3.0 3.0</size></box></geometry><material><ambient>0.88 0.85 0.78 1</ambient><diffuse>0.88 0.85 0.78 1</diffuse></material></visual>
        <collision name="NE_S_0_c"><pose>5.775 4.275 1.5 0 0 0</pose><geometry><box><size>3.15 0.15 3.0</size></box></geometry></collision>
        <visual name="NE_S_0_v"><pose>5.775 4.275 1.5 0 0 0</pose><geometry><box><size>3.15 0.15 3.0</size></box></geometry><material><ambient>0.88 0.85 0.78 1</ambient><diffuse>0.88 0.85 0.78 1</diffuse></material></visual>
