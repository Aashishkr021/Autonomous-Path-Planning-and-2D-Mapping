      <static>true</static>
      <link name="sign_link">
        <collision name="board_c"><pose>0 -7.425 2.5 0 0 0</pose><geometry><box><size>1.5 0.15 1.0</size></box></geometry></collision>
        <visual name="board_v"><pose>0 -7.425 2.5 0 0 0</pose><geometry><box><size>1.5 0.15 1.0</size></box></geometry><material><ambient>0.05 0.35 0.10 1</ambient><diffuse>0.05 0.45 0.12 1</diffuse></material></visual>
        <visual name="out_L0_E_0_0"><pose>-0.6300 -7.51 2.6350 0 0 0</pose><geometry><box><size>0.045 0.02 0.045</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><emissive>1 1 1 1</emissive></material></visual>
