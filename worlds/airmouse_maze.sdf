        <collision name="NE_W_1_c"><pose>4.275 6.725 1.5 0 0 0</pose><geometry><box><size>0.15 1.25 3.0</size></box></geometry></collision>
        <visual name="NE_W_1_v"><pose>4.275 6.725 1.5 0 0 0</pose><geometry><box><size>0.15 1.25 3.0</size></box></geometry><material><ambient>0.88 0.85 0.78 1</ambient><diffuse>0.88 0.85 0.78 1</diffuse></material></visual>
        <collision name="C_N_0_c"><pose>0.0 1.575 1.5 0 0 0</pose><geometry><box><size>3.3 0.15 3.0</size></box></geometry></collision>
        <visual name="C_N_0_v"><pose>0.0 1.575 1.5 0 0 0</pose><geometry><box><size>3.3 0.15 3.0</size></box></geometry><material><ambient>0.88 0.85 0.78 1</ambient><diffuse>0.88 0.85 0.78 1</diffuse></material></visual>
        <collision name="C_S_0_c"><pose>0.0 -1.575 1.5 0 0 0</pose><geometry><box><size>3.3 0.15 3.0</size></box></geometry></collision>
        <visual name="C_S_0_v"><pose>0.0 -1.575 1.5 0 0 0</pose><geometry><box><size>3.3 0.15 3.0</size></box></geometry><material><ambient>0.88 0.85 0.78 1</ambient><diffuse>0.88 0.85 0.78 1</diffuse></material></visual>
        <collision name="C_E_0_c"><pose>1.575 0.0 1.5 0 0 0</pose><geometry><box><size>0.15 3.0 3.0</size></box></geometry></collision>
        <visual name="C_E_0_v"><pose>1.575 0.0 1.5 0 0 0</pose><geometry><box><size>0.15 3.0 3.0</size></box></geometry><material><ambient>0.88 0.85 0.78 1</ambient><diffuse>0.88 0.85 0.78 1</diffuse></material></visual>
        <collision name="C_W_0_c"><pose>-1.575 -1.075 1.5 0 0 0</pose><geometry><box><size>0.15 0.85 3.0</size></box></geometry></collision>
        <visual name="C_W_0_v"><pose>-1.575 -1.075 1.5 0 0 0</pose><geometry><box><size>0.15 0.85 3.0</size></box></geometry><material><ambient>0.88 0.85 0.78 1</ambient><diffuse>0.88 0.85 0.78 1</diffuse></material></visual>
        <collision name="C_W_1_c"><pose>-1.575 1.075 1.5 0 0 0</pose><geometry><box><size>0.15 0.85 3.0</size></box></geometry></collision>
        <visual name="C_W_1_v"><pose>-1.575 1.075 1.5 0 0 0</pose><geometry><box><size>0.15 0.85 3.0</size></box></geometry><material><ambient>0.88 0.85 0.78 1</ambient><diffuse>0.88 0.85 0.78 1</diffuse></material></visual>
      </link>
    </model>

    <!-- exactly 2 obstacles, both in corridor space, 1.5 m high -->
    <model name="obstacles">
      <static>true</static>
      <link name="obstacles">
        <collision name="O1_lobby_pillar_c"><pose>0.0 -3.5 0.75 0 0 0</pose><geometry><box><size>0.6 0.6 1.5</size></box></geometry></collision>
        <visual name="O1_lobby_pillar_v"><pose>0.0 -3.5 0.75 0 0 0</pose><geometry><box><size>0.6 0.6 1.5</size></box></geometry><material><ambient>0.80 0.40 0.10 1</ambient><diffuse>0.80 0.40 0.10 1</diffuse></material></visual>
        <collision name="O2_west_corridor_block_c"><pose>-5.8 1.5 0.75 0 0 0</pose><geometry><box><size>0.5 0.5 1.5</size></box></geometry></collision>
        <visual name="O2_west_corridor_block_v"><pose>-5.8 1.5 0.75 0 0 0</pose><geometry><box><size>0.5 0.5 1.5</size></box></geometry><material><ambient>0.80 0.40 0.10 1</ambient><diffuse>0.80 0.40 0.10 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ENTRY sign: lintel above the 1.5 m opening (clear height 2.0 m), letters on both faces -->
